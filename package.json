{
  "name": "cumuloworks",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @cumuloworks/web dev",
    "dev:brand": "pnpm --filter @cumuloworks/brand dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "fix": "pnpm -r fix",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "typecheck": "pnpm -r typecheck",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "lefthook": "^2.1.9",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "portless": "^0.15.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.129.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.2"
}
