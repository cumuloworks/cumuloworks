{
  "name": "@cumuloworks/brand",
  "version": "0.0.1",
  "private": true,
  "files": [
    "assets",
    "public"
  ],
  "type": "module",
  "exports": {
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "dev": "portless",
    "dev:app": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "oxlint . && oxfmt --check .",
    "fix": "oxlint --fix . && oxfmt .",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "typecheck": "tsc --noEmit",
    "avatar": "node scripts/avatar.ts",
    "masters": "node scripts/masters.ts"
  },
  "dependencies": {
    "astro": "^7.2.0",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.35.3"
  },
  "engines": {
    "node": ">=24"
  },
  "portless": {
    "name": "brand.cumuloworks",
    "script": "dev:app"
  }
}
