    <script type="application/json" id="dl-catalog" is:inline set:html={JSON.stringify(catalog)} />
    <script>
      import { zipSync } from 'fflate';

      interface Variant {
        stem: string;
        ratio: number;
        base: string;
        onDark?: boolean;
        video?: boolean;
        formats: Record<string, number[]>;
        bytes?: Record<string, number>;
      }
      interface Category {
        id: string;
        vector?: string;
        permission?: boolean;
        subjects?: string[];
        variants: Variant[];
      }
      interface Entry {
        href: string;
        file: string;
        dims: string;
        bytes?: number;
      }

      const catalog = JSON.parse(document.getElementById('dl-catalog')!.textContent!) as Category[];
      const root = document.getElementById('dl')!;
      const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const inputs = (name: string) => [...root.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`)];
      const bi = (en: string, ja: string) => `<span class="en">${en}</span><span class="ja">${ja}</span>`;
      const mb = (n: number) => `${(n / 1_048_576).toFixed(n < 1_048_576 ? 2 : 1)} MB`;
      const flash = (b: HTMLElement, cls: string) => {
        b.classList.add(cls);
        setTimeout(() => b.classList.remove(cls), 900);
      };

      // Show only the allowed options and keep the checked one among them.
      function choose(name: string, allowed: string[]): string {
        const all = inputs(name);
        for (const i of all) i.closest('label')!.hidden = !allowed.includes(i.value);
        let on = all.find((i) => i.checked && allowed.includes(i.value));
        if (!on) {
          on = all.find((i) => i.value === allowed[0])!;
          on.checked = true;
        }
        return on.value;
      }

      let entries: Entry[] = [];
      let zipName = '';

      function sync() {
        const cat = catalog.find((c) => c.id === choose('dl-cat', catalog.map((c) => c.id)))!;
        el('dl-subjects').hidden = !cat.subjects;
        const subject = cat.subjects ? choose('dl-subject', cat.subjects) : '';
        const stem = choose('dl-var', cat.variants.map((v) => v.stem));
        const variant = cat.variants.find((v) => v.stem === stem)!;
        const name = stem.replace('{s}', subject);
        const format = choose('dl-fmt', [...Object.keys(variant.formats), ...(cat.vector ? ['svg'] : [])]);
        const vector = format === 'svg';
        const widths = vector ? [] : variant.formats[format];

        const boxes = inputs('dl-size');
        for (const b of boxes) b.closest('label')!.hidden = !widths.includes(Number(b.value));
        el('dl-all').hidden = vector;
        el('dl-vector').hidden = !vector;
        let picked = boxes.filter((b) => b.checked && widths.includes(Number(b.value)));
        if (!vector && picked.length === 0) {
          const largest = boxes.find((b) => Number(b.value) === Math.max(...widths))!;
          largest.checked = true;
          picked = [largest];
        }
        el('dl-permission').hidden = !cat.permission;

        entries = vector
          ? [{ href: cat.vector!, file: cat.vector!.slice(cat.vector!.lastIndexOf('/') + 1), dims: bi('Vector', 'ベクター') }]
          : picked
              .map((b) => Number(b.value))
              .sort((a, b) => a - b)
              .map((w) => ({
                href: `${variant.base}/${name}-${w}.${format}`,
                file: `${name}-${w}.${format}`,
                dims: `${w} × ${Math.round(w * variant.ratio)} px`,
                bytes: variant.bytes?.[`${w}.${format}`],
              }));
        zipName = `cumuloworks-${name}-${format}.zip`;

        // The preview shows the variant, not the chosen size; 512 is plenty on screen.
        const preview = el('dl-preview');
        preview.classList.toggle('ink', variant.onDark === true);
        const still =
          !variant.video && format in variant.formats ? format : 'png' in variant.formats ? 'png' : Object.keys(variant.formats)[0];
        preview.innerHTML = variant.video
          ? `<video src="${variant.base}/${name}-512.mp4" autoplay muted loop playsinline></video>`
          : `<img src="${variant.base}/${name}-512.${still}" alt="" />`;

        el('dl-files').innerHTML = entries
          .map(
            (e) =>
              `<li><span class="f">${e.file}</span><span class="d">${e.dims}${e.bytes ? ` · ${mb(e.bytes)}` : ''}</span>` +
              `<a href="${e.href}" download>${bi('Download', 'ダウンロード')}</a></li>`
          )
          .join('');

        const single = entries.length === 1;
        const get = el<HTMLAnchorElement>('dl-get');
        get.hidden = !single;
        get.href = entries[0].href;
        el('dl-zip').hidden = single;
        el('dl-count').textContent = `(${entries.length})`;
        el('dl-copy').classList.toggle('many', !single);
      }

      root.addEventListener('change', sync);
      el('dl-all').addEventListener('click', () => {
        for (const b of inputs('dl-size')) if (!b.closest('label')!.hidden) b.checked = true;
        sync();
      });
      el('dl-copy').addEventListener('click', async () => {
        await navigator.clipboard.writeText(entries.map((e) => location.origin + e.href).join('\n'));
        flash(el('dl-copy'), 'copied');
      });
      el('dl-zip').addEventListener('click', async () => {
        const btn = el<HTMLButtonElement>('dl-zip');
        btn.disabled = true;
        btn.classList.add('busy');
        try {
          const files = await Promise.all(
            entries.map(async (e) => {
              const res = await fetch(e.href);
              if (!res.ok) throw new Error(`${e.href}: HTTP ${res.status}`);
              return [e.file, new Uint8Array(await res.arrayBuffer())] as const;
            })
          );
          // Everything is already compressed, so store rather than deflate.
          const bytes = zipSync(
            Object.fromEntries(files.map(([file, data]) => [file, [data, { level: 0 }] as [Uint8Array, { level: 0 }]]))
          );
          const url = URL.createObjectURL(new Blob([bytes], { type: 'application/zip' }));
          Object.assign(document.createElement('a'), { href: url, download: zipName }).click();
          setTimeout(() => URL.revokeObjectURL(url), 10_000);
        } finally {
          btn.disabled = false;
          btn.classList.remove('busy');
        }
      });
      sync();
    </script>

    <script is:inline>
      // Language toggle, shared key with the site.
      function applyLang(lang) {
        document.documentElement.setAttribute('data-lang', lang);
        document.documentElement.lang = lang;
        try {
          localStorage.setItem('cw-lang', lang);
        } catch (e) {}
        for (const b of document.querySelectorAll('.lang button')) {
          const on = b.dataset.lang === lang;
          b.classList.toggle('active', on);
          b.setAttribute('aria-pressed', String(on));
        }
      }
      applyLang(document.documentElement.getAttribute('data-lang') || 'en');
      for (const b of document.querySelectorAll('.lang button')) {
        b.addEventListener('click', () => applyLang(b.dataset.lang));
      }

      // Swatches copy their hex.
      for (const b of document.querySelectorAll('.swatch')) {
        b.addEventListener('click', async () => {
          await navigator.clipboard.writeText(b.dataset.hex);
          b.classList.add('copied');
          setTimeout(() => b.classList.remove('copied'), 900);
        });
      }

      // Contents: highlight the section in view and keep the hash in sync.
      const links = new Map(
        [...document.querySelectorAll('[data-toc]')].map((a) => [a.dataset.toc, a])
      );
      function activate(id) {
        for (const a of links.values()) a.classList.remove('active');
        links.get(id)?.classList.add('active');
        const next = links.has(id) ? `#${id}` : '';
        if (location.hash !== next) {
          history.replaceState(null, '', next || location.pathname + location.search);
        }
      }
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) if (e.isIntersecting) activate(e.target.id);
        },
        { rootMargin: '-20% 0px -70% 0px' }
      );
      // Land on the linked section before the observer takes over, so the
      // initial jump isn't overwritten while the page is still laying out.
      const initial = location.hash.slice(1);
      if (links.has(initial)) {
        activate(initial);
        document.getElementById(initial).scrollIntoView({ behavior: 'instant' });
      }
      setTimeout(() => {
        io.observe(document.getElementById('intro'));
        for (const id of links.keys()) io.observe(document.getElementById(id));
      }, 500);
    </script>
  </body>
</html>
