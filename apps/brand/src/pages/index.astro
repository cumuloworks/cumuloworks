---
import '@/styles/brand.css';
import wordmark from '../../assets/type.svg?raw';
import {
  PORTRAIT_IDS,
  SIZES,
  type Variant,
  type VariantName,
  VARIANTS,
  vectorSize,
} from '@/brand';
import Bi from '@/components/Bi.astro';
import { MOTION, type MotionFormat, transcode } from '@/motion';

const year = new Date().getFullYear();

const upRight =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>';
const sections = [
  ['icon', 'Icon'],
  ['gradient', 'Gradient'],
  ['mark', 'Mark'],
  ['wordmark', 'Wordmark'],
  ['color', 'Color'],
  ['typography', 'Typography'],
  ['motion', 'Motion'],
  ['portraits', 'Portraits'],
  ['usage', 'Usage'],
  ['naming', 'Naming'],
  ['downloads', 'Downloads'],
  ['license', 'License'],
];
const num = (id: string) =>
  String(sections.findIndex(([s]) => s === id) + 1).padStart(2, '0');

// Motion weights come from the same encodes the /motion endpoints serve.
const motion = MOTION.animated_icon;
const motionBytes: Record<string, number> = {};
await Promise.all(
  (Object.keys(motion.formats) as MotionFormat[]).flatMap((format) =>
    motion.formats[format].map(async (width) => {
      motionBytes[`${width}.${format}`] = (
        await transcode('animated_icon', width, format)
      ).byteLength;
    })
  )
);

const mark = await vectorSize('mark.svg');
const type = await vectorSize('type.svg');

/**
 * What the download picker offers, as category → variant → format → widths.
 * Portrait variants carry a `{s}` placeholder for the subject.
 */
const FORMAT_LABELS = {
  png: 'PNG',
  jpg: 'JPG',
  webp: 'WebP',
  svg: 'SVG',
  mp4: 'MP4',
  webm: 'WebM',
  gif: 'GIF',
};
const image = (name: VariantName, en: string, ja: string, ratio = 1) => {
  const v: Variant = VARIANTS[name];
  return {
    stem: name as string,
    en,
    ja,
    ratio,
    base: '/i',
    onDark: v.onDark === true,
    formats: Object.fromEntries(v.formats.map((f) => [f, SIZES])),
  };
};
const portrait = (
  suffix: '' | '_logo' | '_logo_masked',
  en: string,
  ja: string,
  ratio = 1
) => ({
  ...image(`portrait_01${suffix}`, en, ja, ratio),
  stem: `portrait_{s}${suffix}`,
});
const catalog = [
  {
    id: 'icon',
    label: 'Icon',
    variants: [
      image('icon_masked', 'Circular', '円形'),
      image('icon', 'Square', '正方形'),
    ],
  },
  {
    id: 'gradient',
    label: 'Gradient',
    variants: [image('gradient', 'Gradient', 'グラデーション')],
  },
  {
    id: 'mark',
    label: 'Mark',
    vector: '/assets/mark.svg',
    variants: [
      image('mark', 'White', '白', mark.height / mark.width),
      image('mark_ink', 'Ink', 'Ink', mark.height / mark.width),
    ],
  },
  {
    id: 'wordmark',
    label: 'Wordmark',
    vector: '/assets/type.svg',
    variants: [
      image('type', 'White', '白', type.height / type.width),
      image('type_ink', 'Ink', 'Ink', type.height / type.width),
    ],
  },
  {
    id: 'motion',
    label: 'Motion',
    variants: [
      {
        stem: 'animated_icon',
        en: 'Animated icon',
        ja: 'アニメーションアイコン',
        ratio: 1,
        base: '/motion',
        video: true,
        formats: motion.formats,
        bytes: motionBytes,
      },
    ],
  },
  {
    id: 'portraits',
    label: 'Portraits',
    permission: true,
    subjects: PORTRAIT_IDS,
    variants: [
      portrait('', 'Photo', '写真', 1.5),
      portrait('_logo', 'With mark', 'マーク入り'),
      portrait('_logo_masked', 'With mark, circular', 'マーク入り・円形'),
    ],
  },
];

const hexToRgb = (hex: string) =>
  hex
    .slice(1)
    .match(/../g)!
    .map((h) => parseInt(h, 16))
    .join(', ');

const gradientStops = [
  ['#7abebf', 'Gradient teal'],
  ['#8bcad3', 'Gradient aqua'],
  ['#e5f0f6', 'Gradient highlight'],
  ['#6ea3cb', 'Gradient periwinkle'],
];
const palette = [
  ['#1d3744', 'Ink', 'Text, dark backgrounds', 'テキスト、暗い背景'],
  ['#2f7e98', 'Denim', 'Links', 'リンク'],
  ['#7be4d5', 'Mint', 'Accent, highlights', 'アクセント、ハイライト'],
  ['#e9edf1', 'Paper', 'Background', '背景'],
];

// Letter bounds follow the SVG artwork and the visible l in the 2048 px icon.
const clearSpaceExamples = [
  {
    label: 'Icon — square',
    src: '/i/icon-512.png',
    width: 96,
    height: 96,
    lTop: 52.78,
    lHeight: 17.34,
    lRight: 31.27,
  },
  {
    label: 'Icon — circular',
    src: '/i/icon_masked-512.png',
    width: 96,
    height: 96,
    lTop: 52.78,
    lHeight: 17.34,
    lRight: 31.27,
  },
  {
    label: 'Mark',
    src: '/i/mark_ink-512.png',
    width: 96,
    height: (96 * mark.height) / mark.width,
    lTop: (96 * 273.02) / mark.width,
    lHeight: (96 * 195.36) / mark.width,
    lRight: (96 * 107.64) / mark.width,
  },
  {
    label: 'Wordmark',
    src: '/i/type_ink-1024.png',
    width: 150,
    height: (150 * type.height) / type.width,
    lTop: 0,
    lHeight: (150 * type.height) / type.width,
    lRight: (150 * 401.48) / type.width,
  },
];
---

<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cumuloworks brand guidelines</title>
    <meta
      name="description"
      content="Brand guidelines and assets for Cumuloworks — icon, gradient, mark, wordmark, color, typography, motion and portraits."
    />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#1d3744" />
    <link rel="icon" href="/i/icon-64.png" type="image/png" />
    <link rel="apple-touch-icon" href="/i/icon-256.png" />
    <meta property="og:title" content="Cumuloworks brand guidelines" />
    <meta property="og:image" content="/i/icon-1024.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=LINE+Seed+JP:wght@400;700&display=swap"
      rel="stylesheet"
    />
    {/* Set the language before paint; shares the site's key so both agree. */}
    <script is:inline>
      (function () {
        var l = 'en';
        try {
          l = localStorage.getItem('cw-lang') || 'en';
        } catch (e) {}
        document.documentElement.setAttribute('data-lang', l);
        document.documentElement.lang = l;
      })();
    </script>
  </head>
  <body>
    <header class="doc-head">
      <div class="in">
        <a class="brand" href="#top">
          <img src="/i/mark_ink-128.png" width="32" height="25" alt="" />
          Cumuloworks
        </a>
        <span class="label"><Bi en="Brand guidelines" ja="ブランドガイドライン" /></span>
        <span class="lang" role="group" aria-label="Language">
          <button type="button" data-lang="en" aria-pressed="true">EN</button><span class="sep">/</span><button
            type="button"
            data-lang="ja"
            aria-pressed="false">JA</button
          >
        </span>
        <a class="site" href="https://cumulo.works" target="_blank" rel="noopener">
          cumulo.works <span class="ar" set:html={upRight} />
        </a>
      </div>
    </header>

    <div class="layout" id="top">
      <nav class="toc" aria-label="Contents">
        <ol>
          {
            sections.map(([id, label], i) => (
              <li>
                <a href={`#${id}`} data-toc={id}>
                  <span class="n">{String(i + 1).padStart(2, '0')}</span>
                  <span class="t">{label}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <main class="doc">
        <section class="intro" id="intro">
          <span class="label">Cumuloworks · {year}</span>
          <h1>Brand guidelines</h1>
          <p class="lede">
            <Bi
              en="Guidelines and assets for representing Cumuloworks consistently."
              ja="Cumuloworks のブランド要素、使用基準、ダウンロード素材をまとめています。"
            />
          </p>
          <div class="kv">
            <img src="/i/icon-1024.png" width="1024" height="1024" alt="The Cumuloworks icon" fetchpriority="high" />
            <div class="banner">
              <img class="bg" src="/i/gradient-2048.jpg" width="2048" height="2048" alt="" fetchpriority="high" />
              <div class="over" set:html={wordmark} />
            </div>
          </div>
        </section>

        {/* 01 ICON */}
        <section class="sec" id="icon">
          <div class="sec-h"><span class="n">{num('icon')}</span><h2>Icon</h2></div>
          <p class="sec-lede">
            <Bi
              en="The primary Cumuloworks icon combines the white mark with the <a href=&quot;#gradient&quot;>gradient</a>. Square and circular versions are available."
              ja="白いマークと<a href=&quot;#gradient&quot;>グラデーション</a>を組み合わせた、Cumuloworks の基本アイコンです。正方形と円形の 2 種類を提供しています。"
            />
          </p>
          <div class="cards">
            <div class="card span">
              <div class="view">
                <figure>
                  <img src="/i/icon-512.png" width="200" height="200" alt="Icon, square" />
                  <figcaption><Bi en="Square · tiles, app icons" ja="正方形はタイルやアプリアイコンに使用します。" /></figcaption>
                </figure>
                <figure>
                  <img class="circle" src="/i/icon_masked-512.png" width="200" height="200" alt="Icon, circular" />
                  <figcaption><Bi en="Circular · avatars" ja="円形はアバターに使用します。" /></figcaption>
                </figure>
              </div>
              <div class="meta">
                <span><b>Icon</b><span class="spec">2048 × 2048 px · PNG / JPG / WebP</span></span>
              </div>
            </div>
          </div>
          <p class="note">
            <Bi
              en="Use the circular icon by default. Use the square version where the platform applies its own shape. Follow the <a href=&quot;#usage&quot;>clear space and minimum size rules</a>."
              ja="原則として円形アイコンを使用してください。掲載先が形状を適用する場合は正方形を使用してください。<a href=&quot;#usage&quot;>余白と最小表示サイズの基準</a>に従ってください。"
            />
          </p>
        </section>

        {/* 02 GRADIENT */}
        <section class="sec" id="gradient">
          <div class="sec-h"><span class="n">{num('gradient')}</span><h2>Gradient</h2></div>
          <p class="sec-lede">
            <Bi
              en="Use the gradient as a background for the white mark or wordmark on covers and headers. You may crop the background image to fit the layout, preserving its proportions. Do not place Ink-colored elements over it."
              ja="カバーやヘッダーでは、白いマークやワードマークの背景として使用してください。背景画像は縦横比を保ち、レイアウトに合わせて切り抜けます。Ink の要素は重ねないでください。"
            />
          </p>
          <div class="banner">
            <img class="bg" src="/i/gradient-2048.jpg" width="2048" height="2048" alt="The gradient, cropped wide" loading="lazy" />
            <div class="over" set:html={wordmark} />
          </div>
          <div class="banner-meta">
            <span>2048 × 2048 px · PNG / JPG / WebP</span>
          </div>
        </section>

        {/* 03 MARK */}
        <section class="sec" id="mark">
          <div class="sec-h"><span class="n">{num('mark')}</span><h2>Mark</h2></div>
          <p class="sec-lede">
            <Bi
              en="The solid-color <code>cml.</code> mark is available in white and Ink. Use it when the gradient cannot be reproduced, such as in embroidery or single-color printing. Use Ink on light backgrounds and white on dark backgrounds."
              ja="白と Ink の単色マークです。刺繍や単色印刷など、グラデーションを再現できない場合に使用してください。明るい背景では Ink、暗い背景では白を使用してください。"
            />
          </p>
          <div class="cards">
            <div class="card">
              <div class="view ink">
                <img src="/i/mark-512.png" width="200" height="159" alt="Mark, white" loading="lazy" />
              </div>
              <div class="meta">
                <span><b><Bi en="White" ja="白" /></b><span class="spec">#ffffff · <Bi en="on Ink" ja="Ink 背景" /></span></span>
              </div>
            </div>
            <div class="card">
              <div class="view checker">
                <img src="/i/mark_ink-512.png" width="200" height="159" alt="Mark, ink" loading="lazy" />
              </div>
              <div class="meta">
                <span><b>Ink</b><span class="spec">#1d3744 · <Bi en="transparent" ja="透過" /></span></span>
              </div>
            </div>
          </div>
        </section>

        {/* 04 WORDMARK */}
        <section class="sec" id="wordmark">
          <div class="sec-h"><span class="n">{num('wordmark')}</span><h2>Wordmark</h2></div>
          <p class="sec-lede">
            <Bi
              en="The wordmark uses lowercase lettering. Use the supplied artwork; do not recreate it with a typeface. Use Ink on light backgrounds and white on dark backgrounds. For the name in text, follow <a href=&quot;#naming&quot;>Naming</a>."
              ja="小文字のレタリングによるワードマークです。提供データを使用し、別の書体で再現しないでください。明るい背景では Ink、暗い背景では白を使用してください。文中の名称は<a href=&quot;#naming&quot;>表記ルール</a>に従ってください。"
            />
          </p>
          <div class="cards">
            <div class="card span">
              <div class="view ink wide">
                <img src="/i/type-1024.png" width="560" height="63" alt="Wordmark, white" loading="lazy" />
              </div>
              <div class="meta">
                <span><b><Bi en="White" ja="白" /></b><span class="spec">#ffffff · <Bi en="on Ink" ja="Ink 背景" /></span></span>
              </div>
            </div>
            <div class="card span">
              <div class="view checker wide">
                <img src="/i/type_ink-1024.png" width="560" height="63" alt="Wordmark, ink" loading="lazy" />
              </div>
              <div class="meta">
                <span><b>Ink</b><span class="spec">#1d3744 · <Bi en="transparent" ja="透過" /></span></span>
              </div>
            </div>
          </div>
        </section>

        {/* 05 COLOR */}
        <section class="sec" id="color">
          <div class="sec-h"><span class="n">{num('color')}</span><h2>Color</h2></div>
          <p class="sec-lede">
            <Bi
              en="The four reference colors describe the gradient's palette. Use the supplied gradient image. The core colors define the palette for Cumuloworks interfaces and documents."
              ja="上段の 4 色はグラデーションの参考色です。グラデーションは提供画像を使用してください。下段は Cumuloworks のインターフェースや資料に使う基本色です。"
            />
          </p>
          <div class="sub"><Bi en="Gradient reference colors" ja="グラデーションの参考色" /></div>
          <div
            class="ramp"
            style={`background: linear-gradient(90deg, ${gradientStops.map(([hex]) => hex).join(', ')})`}
          />
          <div class="swatches">
            {
              gradientStops.map(([hex, name]) => (
                <button class="swatch" type="button" data-hex={hex}>
                  <div class="chip" style={`background:${hex}`} />
                  <div class="hex">
                    <b>{hex}</b>
                    <span>{name}</span>
                    <small>rgb({hexToRgb(hex)})</small>
                  </div>
                </button>
              ))
            }
          </div>
          <div class="sub"><Bi en="Core colors" ja="基本色" /></div>
          <div class="swatches">
            {
              palette.map(([hex, name, en, ja]) => (
                <button class="swatch" type="button" data-hex={hex}>
                  <div class="chip" style={`background:${hex}`} />
                  <div class="hex">
                    <b>{hex}</b>
                    <span>{name} · <Bi en={en} ja={ja} /></span>
                    <small>rgb({hexToRgb(hex)})</small>
                  </div>
                </button>
              ))
            }
          </div>
          <p class="note">
            <Bi en="The white mark and wordmark use White (#ffffff; RGB 255, 255, 255). Paper (#e9edf1) is a background color. Click a swatch to copy its HEX value." ja="白いマークとワードマークには White（#ffffff・RGB 255, 255, 255）を使用します。Paper（#e9edf1）は背景色です。色見本をクリックすると HEX 値をコピーできます。" />
          </p>
        </section>

        {/* 06 TYPOGRAPHY */}
        <section class="sec" id="typography">
          <div class="sec-h"><span class="n">{num('typography')}</span><h2>Typography</h2></div>
          <p class="sec-lede">
            <Bi
              en="Use LINE Seed JP for text and documents created as part of the Cumuloworks brand. This requirement does not apply to independent articles about Cumuloworks. The logo lettering is separate artwork."
              ja="Cumuloworks のブランド表現として作る文章・資料には LINE Seed JP を使用してください。第三者による紹介記事には、この指定は適用しません。ロゴのレタリングは独立した図形です。"
            />
          </p>
          <div class="type-rows">
            <div class="type-row">
              <div>
                <b><Bi en="Mark &amp; wordmark lettering" ja="マーク・ワードマークのレタリング" /></b>
                <small>
                  <Bi
                    en="The mark and wordmark are provided as artwork, not as a font. Use the supplied files without recreating the lettering."
                    ja="マークとワードマークは図形データとして提供しています。フォントとしては提供していません。レタリングを再現せず、提供ファイルを使用してください。"
                  />
                </small>
              </div>
              <img src="/i/type_ink-512.png" width="512" height="58" alt="cumuloworks in the wordmark lettering" loading="lazy" />
            </div>
            <div class="type-row">
              <div>
                <b>LINE Seed JP</b>
                <small>
                  <Bi
                    en="For Latin and Japanese text, use Regular 400 for body text and Bold 700 for headings and emphasis. See the <a href=&quot;https://seed.line.me/&quot;>official LINE Seed site</a> for downloads and the SIL Open Font License 1.1."
                    ja="欧文・和文ともに、本文には Regular 400、見出し・強調には Bold 700 を使用してください。入手先と SIL Open Font License 1.1 は<a href=&quot;https://seed.line.me/&quot;>公式 LINE Seed サイト</a>で確認してください。"
                  />
                </small>
              </div>
              <div class="specimen">
                <div class="big">Motion design, CG &amp; software — <b>モーションデザイン・3DCG</b></div>
                <div class="sm">ABCDEFGHIJKLMNOPQRSTUVWXYZ abcdefghijklmnopqrstuvwxyz 0123456789 あいうえお 雲・空・光</div>
              </div>
            </div>
            <div class="type-row">
              <div>
                <b><Bi en="Highlight underline" ja="下線ハイライト" /></b>
                <small>
                  <Bi
                    en="Links and the current item are marked with a highlighter band, not a text underline. The band is the text's background, <code>linear-gradient(transparent 62%, color 0)</code>, so it sits behind the lower 38% of the line and follows line breaks with <code>box-decoration-break: clone</code>. Links in running text rest in Mint soft (#c2efe7) and fill with Mint (#7be4d5) on hover. In navigation, hover shows the Mint soft band and the current item the Mint band. Do not use it for emphasis, and do not place it on the gradient."
                    ja="リンクと現在の項目は、文字の下線ではなくマーカー状の帯で示します。帯はテキストの背景 <code>linear-gradient(transparent 62%, 色 0)</code> として行の下 38% に敷き、<code>box-decoration-break: clone</code> で折り返しに追従させてください。本文中のリンクは通常時に Mint soft（#c2efe7）の帯、ホバー時は Mint（#7be4d5）で全体を塗ります。ナビゲーションでは、ホバーに Mint soft の帯、現在の項目に Mint の帯を使用してください。強調の目的やグラデーション上では使用しないでください。"
                  />
                </small>
              </div>
              <div class="specimen highlight">
                <p>
                  <Bi
                    en="In running text, <a href=&quot;#color&quot;>a link</a> rests in Mint soft and fills on hover."
                    ja="本文中の<a href=&quot;#color&quot;>リンク</a>は通常時 Mint soft、ホバーで Mint に塗られます。"
                  />
                </p>
                <p class="nav" aria-label="Navigation example">
                  <span>Icon</span><span>Gradient</span><span class="current">Mark</span><span>Wordmark</span>
                </p>
              </div>
            </div>
          </div>
        </section>

        {/* 07 MOTION */}
        <section class="sec" id="motion">
          <div class="sec-h"><span class="n">{num('motion')}</span><h2>Motion</h2></div>
          <p class="sec-lede">
            <Bi
              en="The animated icon loops every 4.7 seconds. Use the supplied files as-is. Do not change the speed, composition or aspect ratio."
              ja="4.7 秒でループするアニメーションアイコンです。提供ファイルをそのまま使用してください。速度・構成・縦横比を変更しないでください。"
            />
          </p>
          <div class="player">
            <video
              src="/motion/animated_icon-1024.mp4"
              poster="/i/icon-1024.png"
              width="1024"
              height="1024"
              controls
              loop
              muted
              playsinline
              preload="metadata"></video>
          </div>
          <p class="note">
            <Bi
              en="Use MP4 by default. Choose WebM or GIF according to the formats supported by the destination. GIF files play at 15 fps."
              ja="原則として MP4 を使用してください。掲載先の対応形式に応じて WebM または GIF を選んでください。GIF は 15 fps です。"
            />
          </p>
        </section>

        {/* 08 PORTRAITS */}
        <section class="sec" id="portraits">
          <div class="sec-h"><span class="n">{num('portraits')}</span><h2>Portraits</h2></div>
          <p class="sec-lede">
            <Bi
              en="<strong>You must obtain permission from Cumuloworks before using any portrait, including for press coverage.</strong> Contact <a href=&quot;mailto:mail@cumulo.works&quot;>mail@cumulo.works</a>. Each portrait is available as a photo and with the mark in square and circular versions."
