              const right = left + example.width;
              const isWordmark = example.label === 'Wordmark';
              const guide = left + example.lRight + (isWordmark ? -3 : 4);
              const lTop = top + example.lTop;
              return (
                <figure class="clearspace">
                  <svg viewBox="0 0 210 180" role="img" aria-label={example.label + ': x is the height of l; dashed boundary shows minimum clear space'}>
                    <image href={example.src} x={left} y={top} width={example.width} height={example.height} />
                    <rect class="space-boundary" x={left - x} y={top - x} width={example.width + 2 * x} height={example.height + 2 * x} />
                    <path class="space-measure" d={
                      `M${guide - 3} ${lTop}h6 M${guide} ${lTop}v${x} M${guide - 3} ${lTop + x}h6 ` +
