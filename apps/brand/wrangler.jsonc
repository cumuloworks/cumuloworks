{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cumuloworks-brand",
  // account_id comes from CLOUDFLARE_ACCOUNT_ID, injected by Workers Builds,
  // so the repo can deploy from either account during the account migration.
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
  },
  // The brand.cumulo.works custom domain is re-added at cutover, once the
  // cumulo.works zone is active in the Cumuloworks account.
}
