{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "web",
  // account_id comes from CLOUDFLARE_ACCOUNT_ID, injected by Workers Builds,
  // so the repo can deploy from either account during the account migration.
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "routes": [
    { "pattern": "cumulo.works", "custom_domain": true },
    { "pattern": "www.cumulo.works", "custom_domain": true },
    // The old domain and its www are redirected to cumulo.works by zone
    // Redirect Rules; the Worker only needs to own the hostnames.
    { "pattern": "cumuloworks.com", "custom_domain": true },
    { "pattern": "www.cumuloworks.com", "custom_domain": true },
  ],
}
